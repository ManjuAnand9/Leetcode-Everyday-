class Codec:
    def encode(self, strs: List[str]) -> str:
     
        new_String= ""
        for i in strs:
            new_String+=str(len(i))+"#"+i
        return (new_String)

        

    def decode(self, s: str) -> List[str]:
        print(s)

        i=0
        j=0
        countString=''

        words=[]
        word=''


        while(i <len(s) and j<len(s)):
            j=i+1
            while(s[j]!='#'):
                j+=1

            countString= s[i:j]

            #print(countString)
            count= int(countString)
            #print(count)

            word= s[j+1:j+1+count]
            #print(word)

            words.append(word)
            i=j+1+count


        return words













    
                        

           


            



        


